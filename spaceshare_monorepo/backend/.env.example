SECRET_KEY=replace-with-a-generated-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Leave DATABASE_URL unset for local dev — falls back to SQLite automatically.
# In production, Render/Railway/Fly set this for you when you attach a
# Postgres addon. Format: postgresql://user:password@host:port/dbname
# DATABASE_URL=

# Only relevant when DATABASE_URL is set. Render/Railway's managed Postgres
# require SSL; a self-hosted/local Postgres usually doesn't.
# DATABASE_SSL_REQUIRE=True

# Only relevant when DEBUG=False. Leave as True unless your host already
# terminates and redirects TLS itself.
# SECURE_SSL_REDIRECT=True
